; Engine configuration file.
; Edit through Godot when possible.
config_version=5

[application]

config/name="Monster Dungeon"
run/main_scene="res://scenes/level_01.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

[display/window]
size/viewport_width=960
size/viewport_height=544
size/window_width_override=960
size/window_height_override=544
stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
